{
  "name": "hrms-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-version.js && next dev",
    "dev:https": "node scripts/generate-version.js && next dev --experimental-https -H 0.0.0.0",
    "build": "node scripts/generate-version.js && prisma generate && next build",
    "build:standalone": "npm run build && node scripts/prepare-standalone.js",
    "start": "next start",
    "seed": "tsx prisma/seed.ts",
    "migrate:drive": "npx tsx src/scripts/migrate-documents-to-drive.ts",
    "sync:drive": "npx tsx src/scripts/sync-drive-storage.ts",
    "seed:roles": "npx tsx scripts/seed-system-roles.ts",
    "sync:attendance-leaves": "npx tsx scripts/sync-attendance-leaves.ts",
    "restore:local": "powershell -ExecutionPolicy Bypass -File scripts/restore-manual-local.ps1",
    "restore:latest": "powershell -ExecutionPolicy Bypass -File scripts/restore-latest-local.ps1",
    "deploy:standalone": "powershell -ExecutionPolicy Bypass -File scripts/deploy-standalone.ps1"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.10.0",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-text-align": "^3.27.3",
    "@tiptap/extension-text-style": "^3.27.3",
    "@tiptap/extension-underline": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@types/leaflet": "^1.9.21",
    "@types/web-push": "^3.6.4",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "minio": "^8.0.7",
    "next": "^16.2.4",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^7.0.13",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "^7.72.0",
    "react-is": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true
  }
}